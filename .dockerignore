# The build context for the container image (deploy/staging/deploy.sh sends
# `git archive HEAD`, so only tracked files reach it; these rules are the second
# guard for anyone running a plain `docker build .`).
#
# Secrets and operator data must never enter an image layer:
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/certs/
**/*.pem
/briefs/*
!/briefs/sample-*
/assets/inputs/*/
/output/
/apps/api/output/
.agents/briefs/

# Built or installed inside the image, never copied in:
**/node_modules
**/.next
**/.output
**/.nitro
**/.turbo
**/dist
**/coverage
.git
