# ============================================================
# Environment Variables — reference file (committed to git).
#
# Copy this to .env.local and fill in your values:
#   cp .env.example .env.local
#
# .env.local holds your real values and is gitignored — never commit it. The
# .gitignore rules live in .gitignore.hexagen; append them once with
# `cat .gitignore.hexagen >> .gitignore` (see SETUP.md).
#
# Mark a variable REQUIRED with a `# required` comment, e.g.:
#   API_KEY=          # required
# `npm run check:env` then fails until every required variable (here and in any
# .env.<template>.example file) has a value in .env.local. An empty value with
# no `# required` annotation is just an optional placeholder.
#
# Installed Hexagen templates ship their own variables in .env.<name>.example
# files (e.g. the bullmq template ships .env.bullmq.example); check:env scans
# all of them.
# ============================================================

# -------- App --------
# development | production | test
NODE_ENV=development
# Public base URL of the app (exposed to the browser).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# error | warn | info | debug
LOG_LEVEL=info

# -------- Database (PT-3, D174a) --------
# PostgreSQL connection URL: postgres://user:password@host:port/database
# Read by `yarn db:ping`, `yarn db:migrate`, and the server when STORE_BACKEND=postgres.
DATABASE_URL=
# The server's CA certificate (PEM), e.g. Aiven's ca.pem, saved under certs/
# (gitignored). Required for any host other than localhost.
DATABASE_CA_PATH=
# Where the stores that have a Postgres adapter keep their records: fs (default)
# or postgres. Explicit: a DATABASE_URL alone never moves the app onto the database.
# Which stores have a Postgres adapter: see apps/api/server/lib/ports/index.ts.
# STORE_BACKEND=fs
# Connections this process may hold (default 5; the Aiven service allows 15 in all).
# DATABASE_POOL_MAX=5
# Do not add HOST or PORT for the database: Nitro and Next.js bind their servers
# to those names. The URL carries the database's host and port.

# -------- Object store (PT-4a, D201) --------
# Where rendered creatives and proofs are written: fs (default — the API serves
# them from GET /output/**) or s3 (a private bucket plus presigned URLs, D204).
# s3 also requires STORE_BACKEND=postgres; it is explicit, and an S3_ENDPOINT on
# its own never moves the app onto a bucket.
# OBJECT_STORE=fs
# The six s3 variables. Both endpoints must be absolute http(s) URLs: the first
# is what the API signs its own requests to (in-cluster), the second is the
# browser-reachable origin presigned URLs are signed for. Use an app key scoped to
# the one bucket, never the store's admin identity.
# S3_ENDPOINT=http://localhost:8333
# S3_PUBLIC_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_BUCKET=campaign-foundry-staging
# S3_ACCESS_KEY_ID=app-key
# S3_SECRET_ACCESS_KEY=app-secret

# -------- Image generation (optional) --------
# Google Gemini / Imagen API key. When set, hero backgrounds are generated with
# Google Imagen; otherwise the pipeline uses the offline procedural generator.
# Get a key at https://aistudio.google.com/apikey — put the real value in .env.local
GEMINI_API_KEY=
# Override the Imagen model (default: imagen-4.0-generate-001; "fast"/"ultra" variants exist).
# IMAGEN_MODEL=imagen-4.0-fast-generate-001
#
# OpenRouter API key — the second GenAI source. When set, a failed/rate-limited
# Imagen call falls back to OpenRouter (Imagen → OpenRouter → procedural) instead
# of straight to the gradient. One key, many image models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Override the OpenRouter image model (default: x-ai/grok-imagine-image-quality).
# Other options: google/gemini-2.5-flash-image, openai/gpt-5-image, etc.
# OPENROUTER_IMAGE_MODEL=x-ai/grok-imagine-image-quality
#
# Adobe Firefly Services (server-to-server). When both are set, selecting the
# "firefly" model generates hero backgrounds with Adobe Firefly (v3), degrading to
# the Imagen → OpenRouter → procedural chain on any failure. Create credentials in
# the Adobe Developer Console (Firefly Services API). https://developer.adobe.com/firefly-services
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
