{
  "name": "campaign-foundry",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "tsx apps/api/bin/generate.ts",
    "db:ping": "tsx apps/api/bin/db.ts ping",
    "db:migrate": "tsx apps/api/bin/db.ts migrate",
    "auth:bootstrap": "tsx apps/api/bin/auth-cli.ts",
    "deploy:staging": "sh deploy/staging/deploy.sh",
    "wave:status": "tsx tools/wave-status/bin.ts",
    "wave:status:print": "tsx tools/wave-status/cli.ts",
    "sweep": "tsx tools/sweep/cli.ts",
    "mutate": "tsx tools/mutate/cli.ts",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck && tsc -p tools/wave-status --noEmit && tsc -p tools/mutate --noEmit && tsc -p tools/plan-verify --noEmit && tsc -p tools/mutate-manifest --noEmit && tsc -p tools/handoff-check --noEmit && tsc -p tools/sweep --noEmit && tsc -p tools/arch-inventory --noEmit && tsc -p tools/control-bytes --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "turbo clean",
    "sync": "hexagen sync",
    "sync:dry": "hexagen sync --dry-run",
    "sync:check": "hexagen sync --check",
    "sync:force": "hexagen sync --force",
    "lint:arch": "hexagen arch validate",
    "lint:bytes": "tsx tools/control-bytes/cli.ts",
    "arch:inventory": "tsx tools/arch-inventory/cli.ts",
    "templates:add": "hexagen add",
    "templates:validate": "hexagen validate-templates",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "plan:verify": "tsx tools/plan-verify/cli.ts",
    "mutate:verify": "tsx tools/mutate-manifest/cli.ts",
    "mutate:anchors": "tsx tools/mutate-manifest/anchors-cli.ts",
    "handoff:check": "tsx tools/handoff-check/cli.ts",
    "format:check": "prettier --check \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@hexagen-monaco/arch-linter": "^0.12.1",
    "@hexagen-monaco/sync": "^0.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.8",
    "eslint": "^9.0.0",
    "happy-dom": "^20.10.2",
    "prettier": "^3.0.0",
    "react": "^19",
    "react-dom": "^19",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.8"
  }
}
